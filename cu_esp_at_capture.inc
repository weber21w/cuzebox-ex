static const cu_at_capture_profile_t *cu_esp_at_capture_find(const char *command){
 for(auint i=0;i<CU_ARRLEN(cu_at_capture_profiles);i++){
  const cu_at_capture_profile_t *p=&cu_at_capture_profiles[i];
  if(p->baud==esp_state.baud_rate&&p->sleep==esp_state.sleep_mode&&p->echo==!!(esp_state.state&ESP_ECHO)&&!strcmp(p->command,command))return p;
 }return NULL;
}
static auint cu_esp_at_capture_delay(const char *command, uint8 reply){
 const cu_at_capture_profile_t *p=cu_esp_at_capture_find(command);if(!p)return 0u;
 auint slot=(esp_state.last_cycle_tick/ESP_AT_MS_DELAY)%p->count;
 return reply?p->replies[slot]:p->cycles[slot];
}
static void cu_esp_at_capture_pause(const char *command,auint reply_base){
 const cu_at_capture_profile_t *p=cu_esp_at_capture_find(command);if(!p)return;
 auint slot=(esp_state.last_cycle_tick/ESP_AT_MS_DELAY)%p->count;
 if(!p->pauses[slot].cycles)return;
 for(auint i=0;i<CU_ARRLEN(esp_state.delay_len);i++)if(!esp_state.delay_len[i]){
  esp_state.delay_len[i]=p->pauses[slot].cycles;
  esp_state.delay_pos[i]=(reply_base+p->pauses[slot].offset)%sizeof(esp_state.read_buf);
  if(!strncmp(command,"AT+CIPSTART=",12)){
   esp_state.delay_len[i]-=p->cycles[slot];
   esp_state.delay_pos[i]|=CU_ESP_CAPTURE_RELATIVE|(reply_base<<CU_ESP_CAPTURE_BASE_SHIFT);
  }return;
 }
}
